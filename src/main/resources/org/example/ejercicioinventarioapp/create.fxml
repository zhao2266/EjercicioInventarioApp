<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" prefWidth="420" prefHeight="470"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.ejercicioinventarioapp.CreateController">
    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
    <Label text="Crear nuevo registro" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Nombre"/>
    <TextField fx:id="txtNombre"/>
    <Label text="Descripción"/>
    <TextArea fx:id="txtDescripcion" prefRowCount="4" wrapText="true"/>
    <Label text="Fecha"/>
    <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
    <Label text="Estado"/>
    <ComboBox fx:id="cbEstado" promptText="Selecciona una opción" maxWidth="Infinity"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="15"/></padding>
        <Button text="Guardar" defaultButton="true" onAction="#onGuardar"/>
        <Button text="Cancelar" cancelButton="true" onAction="#onCancelar"/>
    </HBox>
</VBox>